{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "simulated": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_SIMULATE_CAPTURE": "1"
      },
      "channel": "simulated"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_INTERNAL_BUILD": "1",
        "EXPO_PUBLIC_WEATHER_URL": "https://zezujcujwvnmzxvbchmy.supabase.co/functions/v1/nightwatch-api"
      },
      "channel": "preview"
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_INTERNAL_BUILD": "1",
        "EXPO_PUBLIC_WEATHER_URL": "https://zezujcujwvnmzxvbchmy.supabase.co/functions/v1/nightwatch-api"
      },
      "channel": "ios-simulator"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "testflight": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_INTERNAL_BUILD": "1",
        "EXPO_PUBLIC_WEATHER_URL": "https://zezujcujwvnmzxvbchmy.supabase.co/functions/v1/nightwatch-api"
      },
      "channel": "preview"
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "ios": {
        "ascApiKeyPath": "./credentials/AuthKey.p8",
        "ascApiKeyIssuerId": "SET_ME",
        "ascApiKeyId": "SET_ME",
        "ascAppId": "SET_ME"
      }
    }
  }
}
