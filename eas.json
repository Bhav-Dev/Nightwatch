{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "simulated": {
      "extends": "development",
      "env": { "EXPO_PUBLIC_SIMULATE_CAPTURE": "1" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_INTERNAL_BUILD": "1",
        "EXPO_PUBLIC_WEATHER_URL": "https://zezujcujwvnmzxvbchmy.supabase.co/functions/v1/nightwatch-api"
      }
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_INTERNAL_BUILD": "1",
        "EXPO_PUBLIC_WEATHER_URL": "https://zezujcujwvnmzxvbchmy.supabase.co/functions/v1/nightwatch-api"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
