{
  "expo": {
    "name": "Nightwatch",
    "slug": "nightwatch",
    "scheme": "nightwatch",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1629",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.threeft2.nightwatch",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.threeft2.nightwatch",
      "adaptiveIcon": {
        "backgroundColor": "#0F1629",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_SLEEP"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Nightwatch listens for snoring while you sleep. Audio is processed on this phone and is not uploaded.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-sharing",
      "expo-web-browser",
      "expo-secure-store",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {}
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Nightwatch reads sleep, heart rate, heart rate variability, oxygen and breathing rate from Apple Health to show them alongside your snoring. Raw readings stay on this phone.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "564577d1-dadc-4c2b-8ee4-a21646fef1ed"
      }
    },
    "owner": "vesuviuss-team"
  }
}
