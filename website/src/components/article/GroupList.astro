---
import { alcohol } from '../../data/community';

/**
 * Extra snore-score points after drinks, by group. Groups too small to report say so.
 */
---

<div class="card rows groups">
  {
    alcohol.groups.map((g) => (
      <div class="row groups__row">
        <p class="groups__label">{g.label}</p>
        {g.points === null ? (
          <p class="groups__none">Not enough people yet</p>
        ) : (
          <p class="groups__value">{`${g.points > 0 ? '+' : '−'}${Math.abs(g.points)} points`}</p>
        )}
      </div>
    ))
  }
</div>

<style>
  .groups__row {
    flex-wrap: nowrap;
    justify-content: space-between;
    padding-block: 16px;
  }
  .groups__label {
    flex: 1 1 auto;
    min-width: 0;
    font-weight: 700;
  }
  .groups__value {
    color: var(--text);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .groups__none {
    color: var(--faint);
  }
</style>
