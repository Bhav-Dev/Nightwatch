---
import { LOGO_PATH } from '../lib/hex';

interface Props {
  /** Unique on the page: the gradients and mask need their own ids. */
  id: string;
  size?: number;
  strokeWidth?: number;
}

const { id, size = 40, strokeWidth = 6 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 100 100" aria-hidden="true" class="logo">
  <defs>
    <linearGradient id={`${id}-cell`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#353C99"></stop>
      <stop offset="1" stop-color="#2A2F7F"></stop>
    </linearGradient>
    <linearGradient id={`${id}-honey`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FFE9AE"></stop>
      <stop offset="0.5" stop-color="#F6C85F"></stop>
      <stop offset="1" stop-color="#E9A23F"></stop>
    </linearGradient>
    <mask id={`${id}-moon`}>
      <rect width="100" height="100" fill="#fff"></rect>
      <circle cx="58" cy="36" r="16" fill="#000"></circle>
    </mask>
  </defs>
  <path d={LOGO_PATH} fill={`url(#${id}-cell)`} stroke={`url(#${id}-honey)`} stroke-width={strokeWidth} stroke-linejoin="round"></path>
  <circle cx="48" cy="44" r="19" fill="#F7D990" mask={`url(#${id}-moon)`}></circle>
  <path d="M22,66 C30,60 36,60 42,64 S54,72 60,66 S72,58 78,64" fill="none" stroke="#BAB6FA" stroke-width={strokeWidth - 1} stroke-linecap="round"></path>
</svg>

<style>
  .logo {
    flex: none;
  }
</style>
