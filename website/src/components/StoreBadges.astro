---
import { stores } from '../config';

/**
 * The official App Store and Google Play badges, linked to the listings.
 */
interface Props {
  id?: string;
  center?: boolean;
  /** Badge height in px; both badges are drawn the same height. */
  height?: number;
}

const { id, center = false, height = 52 } = Astro.props;
// Apple's badge is 119.66 x 40; Google's, trimmed to the badge, is 564 x 168.
const appleWidth = Math.round((height * 119.66407) / 40);
const googleWidth = Math.round((height * 564) / 168);
---

<div class:list={['stores', { 'stores--center': center }]} id={id}>
  <div class="stores__badges">
    <a class="stores__badge" href={stores.appStore} rel="noopener">
      <img src="/badges/app-store.svg" width={appleWidth} height={height} alt="Download on the App Store" />
    </a>
    <a class="stores__badge" href={stores.googlePlay} rel="noopener">
      <img src="/badges/google-play.png" width={googleWidth} height={height} alt="Get it on Google Play" />
    </a>
  </div>
  {!stores.live && <p class="stores__note">Coming soon to the App Store and Google Play.</p>}
</div>

<style>
  .stores {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .stores--center {
    align-items: center;
  }
  .stores__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .stores--center .stores__badges {
    justify-content: center;
  }
  .stores__badge {
    display: block;
    border-radius: 10px;
    transition:
      transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.22s ease,
      filter 0.22s ease;
  }
  .stores__badge:hover {
    filter: brightness(1.12);
    box-shadow:
      0 0 0 1px rgba(246, 200, 95, 0.7),
      0 12px 30px rgba(246, 200, 95, 0.22);
  }
  .stores__badge:focus-visible {
    outline: 3px solid var(--honey);
    outline-offset: 4px;
    border-radius: 12px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .stores__badge:hover {
      transform: translateY(-3px);
    }
    .stores__badge:active {
      transform: translateY(-1px) scale(0.97);
      transition-duration: 0.08s;
    }
  }
  .stores__badge img {
    display: block;
    width: auto;
    max-width: 100%;
  }
  .stores__note {
    color: var(--faint);
    font-size: 13px;
  }
</style>
