---
import Cell from './Cell.astro';

/**
 * The app's This Morning screen, drawn in HTML. An example night, not anyone's data.
 */
const bars = [
  [8, 'quiet'],
  [14, 'quiet'],
  [26, 'light'],
  [40, 'moderate'],
  [30, 'light'],
  [10, 'quiet'],
  [8, 'quiet'],
  [22, 'light'],
  [50, 'epic'],
  [44, 'loud'],
  [18, 'light'],
  [8, 'quiet'],
  [12, 'quiet'],
  [28, 'moderate'],
  [14, 'quiet'],
  [8, 'quiet'],
] as const;
---

<div
  class="phone"
  role="img"
  aria-label="The SnoreHive This Morning screen: a snore score of 34, light, in a honeycomb cell, with the night's timeline"
>
  <div class="phone__screen">
    <div>
      <p class="phone__eyebrow">This morning</p>
      <p class="phone__date">Monday 19 October</p>
    </div>
    <div class="phone__card phone__score">
      <Cell width={92} fill="rgba(246,200,95,0.08)" honeyStrokeId="phone-honey" textSize={40}>34</Cell>
      <div class="phone__score-text">
        <p class="phone__band">Light</p>
        <p class="phone__vs">↓ 6 vs your 7-night average</p>
        <p class="phone__facts">12% snoring · 7h 20m in bed</p>
      </div>
    </div>
    <div class="phone__card phone__timeline">
      <p class="phone__label">Timeline</p>
      <div class="phone__bars" aria-hidden="true">
        {bars.map(([h, level]) => <span style={`height:${h}px;background:var(--level-${level})`} />)}
      </div>
      <div class="phone__times"><span>23:00</span><span>02:00</span><span>05:00</span></div>
      <div class="phone__moment">
        <span>03:12 · Snoring, loud</span>
        <span class="phone__chip">✓ Snoring</span>
      </div>
    </div>
  </div>
</div>

<style>
  .phone {
    width: 300px;
    max-width: 100%;
    border-radius: 44px;
    padding: 10px;
    background: #05071a;
    border: 1px solid var(--line-strong);
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.5),
      0 0 120px rgba(246, 200, 95, 0.12);
  }
  .phone__screen {
    border-radius: 36px;
    overflow: hidden;
    background: linear-gradient(180deg, #f9c59a 0%, #ee9a8f 22%, #b07597 45%, #4b4a88 70%, #1f2558 100%);
    padding: 40px 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .phone__eyebrow {
    color: #8a3f2c;
    font-weight: 800;
    font-size: 12px;
  }
  .phone__date {
    color: #2a1f3d;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
  }
  .phone__card {
    background: rgba(28, 26, 66, 0.86);
    border-radius: 22px;
  }
  .phone__score {
    padding: 18px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .phone__score-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .phone__band {
    color: var(--honey);
    font-weight: 800;
    font-size: 17px;
  }
  .phone__vs {
    color: var(--muted);
    font-size: 12px;
  }
  .phone__facts {
    color: var(--text);
    font-size: 12px;
    margin-top: 6px;
  }
  .phone__timeline {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .phone__label {
    color: var(--text);
    font-weight: 700;
    font-size: 14px;
  }
  .phone__bars {
    height: 54px;
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .phone__bars span {
    flex: 1;
    border-radius: 2px;
  }
  .phone__times {
    display: flex;
    justify-content: space-between;
    color: var(--faint);
    font-size: 10px;
  }
  .phone__moment {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: var(--card-raised);
    border-radius: var(--radius-inset);
    padding: 10px 12px;
    color: var(--text);
    font-size: 12px;
    font-weight: 700;
  }
  .phone__chip {
    background: var(--honey);
    color: var(--on-honey);
    font-size: 11px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 999px;
    white-space: nowrap;
  }
</style>
