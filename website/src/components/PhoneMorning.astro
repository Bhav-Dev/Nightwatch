---
/**
 * A real screenshot of the app's This Morning screen in a phone frame. The images come from
 * scripts/make-screens.mjs (status bar trimmed); run it again with a newer screenshot to update.
 */
interface Props {
  /** Load straight away (the hero) rather than when scrolled near. */
  eager?: boolean;
}
const { eager = true } = Astro.props;
// public/screens/morning-*: 1440 x 2996 after the status bar was trimmed.
const width = 320;
const height = Math.round((width * 2996) / 1440);
---

<figure class="phone">
  <div class="phone__frame">
    <picture>
      <source
        type="image/webp"
        srcset="/screens/morning-320.webp 320w, /screens/morning-640.webp 640w, /screens/morning-960.webp 960w"
        sizes="(max-width: 420px) 76vw, 320px"
      />
      <img
        class="phone__screen"
        src="/screens/morning-640.jpg"
        width={width}
        height={height}
        alt="The SnoreHive This Morning screen: last night's snore score, 13 and quiet, in a honeycomb cell, with time snoring, time in bed and a summary of the night"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
      />
    </picture>
  </div>
</figure>

<style>
  .phone {
    margin: 0;
    width: 320px;
    max-width: 76vw;
    position: relative;
  }
  /* The honey glow behind the phone. */
  .phone::before {
    content: '';
    position: absolute;
    inset: 8% -18% 4%;
    background: radial-gradient(closest-side, rgba(246, 200, 95, 0.22), transparent);
    filter: blur(20px);
    z-index: -1;
  }
  .phone__frame {
    border-radius: 46px;
    padding: 9px;
    background: linear-gradient(160deg, #1b2150, #05071a 45%, #11163a);
    border: 1px solid var(--line-strong);
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.55),
      inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }
  .phone__screen {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 38px;
    background: #f3b49a;
  }

  @media (prefers-reduced-motion: no-preference) {
    .phone__frame {
      animation: phone-float 7s ease-in-out infinite;
    }
    @keyframes phone-float {
      0%,
      100% {
        transform: translateY(0) rotate(-0.6deg);
      }
      50% {
        transform: translateY(-10px) rotate(0.6deg);
      }
    }
  }
</style>
